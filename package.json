{
  "name": "@taixu/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:contract": "vitest run tests/contract.test.ts",
    "verify": "npm run build --workspaces --if-present && npm run typecheck && npm run test",
    "dev": "vite demo",
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "verify:fast": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.8",
    "dompurify": "^3.4.14",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.41"
  },
  "description": "Taixu 微前端框架 monorepo（发布物在 packages/*：@taixu/core + 4 适配器包）",
  "workspaces": [
    "packages/*"
  ]
}