  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json"
  },
  "dependencies": {
    "@taixu/core": "^0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
