{
  "name": "@taixu/adapter-vue3",
  "version": "0.1.0",
  "description": "Taixu Vue 3 适配器（含 SSR adopt：容器 data-tx-ssr 标记自动走 createSSRApp hydration）",
  "type": "module",
  "license": "MIT",
  "main": "./dist/vue3-adapter.js",
  "module": "./dist/vue3-adapter.js",
